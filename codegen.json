{
  "kotlin": {
    "fabriktVersion": "23.0.0",
    "defaults": {
      "basePackagePrefix": "com.example.contracts",
      "targets": [
        "HTTP_MODELS"
      ],
      "validationLibrary": "JAKARTA_VALIDATION",
      "serializationLibrary": "JACKSON",
      "typeOverrides": [
        "DATETIME_AS_INSTANT"
      ],
      "modelOptions": []
    },
    "services": {}
  },
  "dart": {
    "openapiGeneratorVersion": "7.26.0",
    "generator": "dart-dio",
    "packageName": "api_contracts",
    "packageVersion": "0.0.1",
    "sdkConstraint": "^3.8.0",
    "additionalProperties": {
      "serializationLibrary": "json_serializable",
      "finalProperties": "true",
      "skipCopyWith": "true",
      "enumUnknownDefaultCase": "true"
    },
    "dependencies": {
      "dio": "^5.7.0",
      "json_annotation": "^4.9.0"
    },
    "devDependencies": {
      "build_runner": "^2.4.13",
      "json_serializable": "^6.9.0"
    },
    "services": {}
  }
}
